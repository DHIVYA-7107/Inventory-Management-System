// ---------- Main Class ----------
public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        InventoryManager manager = new InventoryManager();
        FinalMessage message = new FinalMessage();
        int choice = -1; //  FIXED initialization
        do {
            System.out.println("\n========= Inventory Management Menu =========");
            System.out.println("1. Add Product");
            System.out.println("2. View Products");
            System.out.println("3. Update Product");
            System.out.println("4. Delete Product");
            System.out.println("5. Sell Product");
            System.out.println("6. Low Stock Reminder");
            System.out.println("7. Save/Load from File");
            System.out.println("0. Exit");
            System.out.print("Enter your choice: ");
            try {
                choice = scanner.nextInt();
                scanner.nextLine();
                switch (choice) {
                    case 1 -> manager.addProduct(scanner);
                    case 2 -> manager.viewProducts();
                    case 3 -> manager.updateProduct(scanner);
                    case 4 -> manager.deleteProduct(scanner);
                    case 5 -> manager.sellProduct(scanner);
                    case 6 -> manager.runStockCheck();
                    case 7 -> manager.saveLoadFile(scanner);
                    case 0 -> message.show();
                    default -> System.out.println("Invalid choice. Try again.");
                }
            } catch (InputMismatchException e) {
                System.out.println("Invalid input! Please enter a number.");
                scanner.nextLine();
            }
        } while (choice != 0);
         scanner.close();
        System.out.println("Program terminated");
    }
}
