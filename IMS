    // File Save / Load
    public void saveLoadFile(Scanner sc) {
        try {
            System.out.print("Do you want to save data? (y/n): ");
            char ch = sc.next().charAt(0);
            if (ch == 'y') {
                FileWriter fw = new FileWriter("inventory.txt");
                for (Product p : products) {
                    fw.write(p.getId() + "," + p.getName() + "," + p.getCategory() + "," + p.getQuantity() + "," + p.getPrice() + "\n");
                }
                fw.close();
                System.out.println("Data saved to inventory.txt");
            }
            System.out.print("Do you want to load data? (y/n): ");
            ch = sc.next().charAt(0);
            if (ch == 'y') {
                File file = new File("inventory.txt");
                if (!file.exists()) {
                    System.out.println("No file found to load!");
                    return;
                }
                BufferedReader br = new BufferedReader(new FileReader(file));
                String line;
                while ((line = br.readLine()) != null) {
                    String[] parts = line.split(",");
                    products.add(new Product(Integer.parseInt(parts[0]), parts[1], parts[2],
                            Integer.parseInt(parts[3]), Double.parseDouble(parts[4])));
                }
                br.close();
                System.out.println(" Data loaded successfully!");
            }
        } catch (Exception e) {
            System.out.println("File error: " + e.getMessage());
        }
    }
}

