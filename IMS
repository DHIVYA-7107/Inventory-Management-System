// View Products
    public void viewProducts() {
        if (products.isEmpty()) {
            System.out.println("No products available.");
            return;
        }
        System.out.println("\n--- Product List ---");
        for (Product p : products) {
            p.display();
        }
    }

// Abstract method implementation
    @Override
    void displayProducts() {
        viewProducts();
    }

// Update Product
    public void updateProduct(Scanner sc) {
        System.out.print("Enter Product ID to update: ");
        int id = sc.nextInt();
        sc.nextLine();
        boolean found = false;
        for (Product p : products) {
            if (p.getId() == id) {
                found = true;
                System.out.println("Existing Details:");
                p.display();
                System.out.print("Enter new name: ");
                String name = sc.nextLine();
                System.out.print("Enter new category: ");
                String category = sc.nextLine();
                System.out.print("Enter new quantity: ");
                int qty = sc.nextInt();
                System.out.print("Enter new price: ");
                double price = sc.nextDouble();
                p.setName(name);
                p.setCategory(category);
                p.setQuantity(qty);
                p.setPrice(price);
                System.out.println("Product updated successfully!");
                break;
            }
        }
        if (!found) System.out.println("Product ID not found.");
    }

// Delete Product
    public void deleteProduct(Scanner sc) {
        System.out.print("Enter Product ID to delete: ");
        int id = sc.nextInt();
        boolean removed = products.removeIf(p -> p.getId() == id);
        if (removed)
            System.out.println("Product deleted successfully!");
        else
            System.out.println("Product not found.");
    }

// Sell Product (Polymorphism)
    public void sellProduct(Scanner sc) {
        System.out.print("Enter Product ID to sell: ");
        int id = sc.nextInt();
        System.out.print("Enter Quantity to sell: ");
        int qty = sc.nextInt();
        sc.nextLine();
        System.out.print("Enter Customer Type (regular/premium): ");
        String type = sc.nextLine();
        for (Product p : products) {
            if (p.getId() == id) {
                if (qty > p.getQuantity()) {
                    System.out.println("Insufficient stock!");
                    return;
                }
                DiscountedProduct dp = new DiscountedProduct(p.getId(), p.getName(), p.getCategory(), p.getQuantity(), p.getPrice());
                double bill = dp.calculateBill(qty, type.equalsIgnoreCase("premium"));
                p.setQuantity(p.getQuantity() - qty);
                System.out.println("Final Bill: ₹" + bill);
                return;
            }
        }
        System.out.println("Product not found.");
    }

// Run Stock Check Thread
    public void runStockCheck() {
        StockChecker checker = new StockChecker(products);
        checker.start();
    }

// File Save / Load
    public void saveLoadFile(Scanner sc) {
        try {
            System.out.print("Do you want to save data? (y/n): ");
            char ch = sc.next().charAt(0);
            if (ch == 'y') {
                FileWriter fw = new FileWriter("inventory.txt");
                for (Product p : products) {
                    fw.write(p.getId() + "," + p.getName() + "," + p.getCategory() + "," + p.getQuantity() + "," + p.getPrice() + "\n");
                }
                fw.close();
                System.out.println("Data saved to inventory.txt");
            }
            System.out.print("Do you want to load data? (y/n): ");
            ch = sc.next().charAt(0);
            if (ch == 'y') {
                File file = new File("inventory.txt");
                if (!file.exists()) {
                    System.out.println("No file found to load!");
                    return;
                }
                BufferedReader br = new BufferedReader(new FileReader(file));
                String line;
                while ((line = br.readLine()) != null) {
                    String[] parts = line.split(",");
                    products.add(new Product(Integer.parseInt(parts[0]), parts[1], parts[2],
                            Integer.parseInt(parts[3]), Double.parseDouble(parts[4])));
                }
                br.close();
                System.out.println(" Data loaded successfully!");
            }
        } catch (Exception e) {
            System.out.println("File error: " + e.getMessage());
        }
    }
}

